if __name__ == "__main__":
    logging.basicConfig(level=logging.INFO)

    # SAML 2.0 example
    saml_config = SPAdapterConfiguration(
        adapter_id="saml-sp",
        adapter_name="SAML 2.0 Service Provider",
        adapter_type="sp",
        authentication_method=SPAuthenticationMethod.SAML2,
        idp_endpoint_url="https://pingfederate.example.com/sp",
        accepted_issuer="https://pingfederate.example.com",
        audience="my-application",
        secret_key="super-secret-key",
        enable_caching=True,
        cache_ttl_seconds=3600,
        attribute_mapping={"mail": "email", "groups": "user_groups"},
    )

    saml_adapter = SPAdapterFactory.create_adapter(saml_config)
    manager = SPAdapterManager()
    manager.register(saml_adapter)

    saml_assertion = """<?xml version="1.0" encoding="UTF-8"?>
    <saml2:Assertion xmlns:saml2="urn:oasis:names:tc:SAML:2.0:assertion">
      <saml2:Issuer>https://pingfederate.example.com</saml2:Issuer>
      <saml2:Subject>
        <saml2:NameID>john.smith@example.com</saml2:NameID>
      </saml2:Subject>
      <saml2:AuthnStatement SessionNotOnOrAfter="2026-09-29T10:30:00Z">
        <saml2:AuthnContext/>
      </saml2:AuthnStatement>
      <saml2:AttributeStatement>
        <saml2:Attribute Name="mail">
          <saml2:AttributeValue>john.smith@example.com</saml2:AttributeValue>
        </saml2:Attribute>
        <saml2:Attribute Name="groups">
          <saml2:AttributeValue>admins</saml2:AttributeValue>
          <saml2:AttributeValue>developers</saml2:AttributeValue>
        </saml2:Attribute>
      </saml2:AttributeStatement>
    </saml2:Assertion>
    """

    auth_request = SPAuthenticationRequest(
        username="john.smith@example.com",
        credentials={"assertion": saml_assertion},
        request_id="req-001",
        timestamp=datetime.utcnow(),
        ip_address="10.0.0.25",
        user_agent="Mozilla/5.0",
    )

    result = manager.authenticate("saml-sp", auth_request)
    print("Authentication Result:")
    print(result)

    if result.success:
        print("\nSession token:", result.session_token)
        valid, user_id = manager.validate_session("saml-sp", result.session_token)
        print("Session valid:", valid, "User:", user_id)

        attrs = manager.get_session_attributes("saml-sp", result.session_token)
        print("Session attributes:", attrs)

        logged_out = manager.logout("saml-sp", result.session_token)
        print("Logged out:", logged_out)
