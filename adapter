class OAuth2Adapter(AuthenticationAdapter):
    """Example OAuth2 bearer token adapter."""

    def authenticate(self, request: AuthenticationRequest) -> AuthenticationResponse:
        username = request.username
        credentials = request.credentials

        try:
            if not self.validate_credentials(username, credentials):
                raise AuthenticationFailedException("Invalid bearer token")

            access_token = credentials.get("access_token")
            user_info = self._fetch_user_info(access_token)
            user_id = user_info.get("sub") or username
            attributes = self.get_user_attributes(user_id)
            session_token = self.session_manager.create_session(user_id, attributes)
            token_expiry = datetime.utcnow() + timedelta(seconds=self.config.cache_ttl_seconds)

            return AuthenticationResponse(
                success=True,
                user_id=user_id,
                session_token=session_token,
                token_expiry=token_expiry,
                attributes={**attributes, **user_info},
            )
        except Exception as exc:
            logger.exception("OAuth2 authentication failed")
            return AuthenticationResponse(
                success=False,
                user_id="",
                session_token="",
                token_expiry=datetime.utcnow(),
                attributes={},
                error_message=str(exc),
                error_code=getattr(exc, "error_code", "AUTH_ERROR"),
            )

    def validate_credentials(self, username: str, credentials: Dict[str, Any]) -> bool:
        access_token = credentials.get("access_token")
        if not username or not access_token:
            return False
        return True

    def get_user_attributes(self, user_id: str) -> Dict[str, Any]:
        key = f"oauth2_user:{user_id}"
        cached = self._cache_get(key)
        if cached:
            return cached

        attrs = {
            "user_id": user_id,
            "groups": ["oauth_users"],
            "oauth2_enabled": True,
            "authenticated_at": datetime.utcnow().isoformat(),
        }
        self._cache_set(key, attrs)
        return attrs

    def _fetch_user_info(self, access_token: str) -> Dict[str, Any]:
        # Replace with a real call to your OAuth2 provider's userinfo endpoint.
        return {
            "sub": "oauth-user-123",
            "name": "OAuth User",
            "email": "oauth-user@example.com",
        }


class AdapterFactory:
    _registry: Dict[AuthenticationMethod, type] = {
        AuthenticationMethod.BASIC: BasicAuthAdapter,
        AuthenticationMethod.API_KEY: APIKeyAdapter,
        AuthenticationMethod.OAUTH2: OAuth2Adapter,
    }

    @classmethod
    def create_adapter(cls, config: AdapterConfiguration) -> AuthenticationAdapter:
        adapter_class = cls._registry.get(config.authentication_method)
        if adapter_class is None:
            raise ConfigurationException(f"Unsupported authentication method: {config.authentication_method}")
        return adapter_class(config)

    @classmethod
    def register_adapter(cls, method: AuthenticationMethod, adapter_class: type):
        cls._registry[method] = adapter_class


class AdapterManager:
    def __init__(self):
        self.adapters: Dict[str, AuthenticationAdapter] = {}

    def register(self, adapter: AuthenticationAdapter):
        self.adapters[adapter.config.adapter_id] = adapter

    def get(self, adapter_id: str) -> Optional[AuthenticationAdapter]:
        return self.adapters.get(adapter_id)

    def authenticate(self, adapter_id: str, request: AuthenticationRequest) -> AuthenticationResponse:
        adapter = self.get(adapter_id)
        if not adapter:
            return AuthenticationResponse(
                success=False,
                user_id="",
                session_token="",
                token_expiry=datetime.utcnow(),
                attributes={},
                error_message=f"Adapter not found: {adapter_id}",
                error_code="ADAPTER_NOT_FOUND",
            )
        return adapter.authenticate(request)

    def validate_session(self, adapter_id: str, session_token: str) -> Tuple[bool, Optional[str]]:
        adapter = self.get(adapter_id)
        if not adapter:
            return False, None
        return adapter.session_manager.validate_session(session_token)


def retry_on_failure(max_retries: int = 3, delay_ms: int = 1000):
    def decorator(func):
        def wrapper(*args, **kwargs):
            for attempt in range(1, max_retries + 1):
                try:
                    return func(*args, **kwargs)
                except Exception as exc:
                    if attempt == max_retries:
                        raise
                    logger.warning("Retrying %s after %s ms (attempt %s/%s): %s", func.__name__, delay_ms, attempt, max_retries, exc)
                    time.sleep(delay_ms / 1000.0)
        return wrapper
    return decorator


def mask_sensitive_data(payload: Dict[str, Any], sensitive_keys: Optional[List[str]] = None) -> Dict[str, Any]:
    if sensitive_keys is None:
        sensitive_keys = ["password", "api_key", "secret_key", "access_token", "token"]

    masked = dict(payload)
    for key in sensitive_keys:
        if key in masked:
            masked[key] = "***MASKED***"
    return masked


