#!/usr/bin/env python3
"""
PingFederate Custom Authentication Adapter
========================================

This sample demonstrates how to build a custom authentication adapter in Python
that can integrate with PingFederate. It includes:
- Adapter configuration model
- Authentication request/response handling
- Session token generation and validation
- Basic / API key / OAuth2-style adapter implementations
- Request retry and secure logging utilities

This is a framework example for integration work, not a direct PingFederate SDK.
In a real deployment, replace the placeholder validation methods with your own
identity provider or enterprise auth logic.
"""

import hashlib
import hmac
import logging
import os
import time
from abc import ABC, abstractmethod
from dataclasses import dataclass, field
from datetime import datetime, timedelta
from enum import Enum
from typing import Any, Dict, List, Optional, Tuple

import requests

logger = logging.getLogger("pingfederate_adapter")
logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s")


class AuthenticationMethod(Enum):
    BASIC = "basic"
    API_KEY = "api_key"
    OAUTH2 = "oauth2"
    SAML = "saml"
    CUSTOM = "custom"


class AdapterStatus(Enum):
    ACTIVE = "active"
    INACTIVE = "inactive"
    ERROR = "error"
    DEGRADED = "degraded"


@dataclass
class AuthenticationRequest:
    username: str
    credentials: Dict[str, Any]
    request_id: str
    timestamp: datetime
    ip_address: Optional[str] = None
    user_agent: Optional[str] = None
    context: Dict[str, Any] = field(default_factory=dict)


@dataclass
class AuthenticationResponse:
    success: bool
    user_id: str
    session_token: str
    token_expiry: datetime
    attributes: Dict[str, Any] = field(default_factory=dict)
    error_message: Optional[str] = None
    error_code: Optional[str] = None


@dataclass
class AdapterConfiguration:
    adapter_id: str
    adapter_name: str
    adapter_type: str
    authentication_method: AuthenticationMethod
    endpoint_url: str
    api_key: Optional[str] = None
    secret_key: Optional[str] = None
    timeout_seconds: int = 30
    max_retries: int = 3
    retry_delay_ms: int = 1000
    enable_caching: bool = True
    cache_ttl_seconds: int = 3600
    custom_config: Dict[str, Any] = field(default_factory=dict)


class AdapterException(Exception):
    def __init__(self, message: str, error_code: str = "ADAPTER_ERROR"):
        self.message = message
        self.error_code = error_code
        super().__init__(message)


class ConfigurationException(AdapterException):
    def __init__(self, message: str):
        super().__init__(message, "CONFIG_ERROR")


class AuthenticationFailedException(AdapterException):
    def __init__(self, message: str):
        super().__init__(message, "AUTH_FAILED")


class ConnectionException(AdapterException):
    def __init__(self, message: str):
        super().__init__(message, "CONNECTION_ERROR")


class SessionManager:
    """Creates and validates user sessions for PingFederate adapter integrators."""

    def __init__(self, secret_key: str, ttl_seconds: int = 3600):
        self.secret_key = secret_key or "change-me-secret"
        self.ttl_seconds = ttl_seconds
        self.sessions: Dict[str, Dict[str, Any]] = {}

    def create_session(self, user_id: str, attributes: Dict[str, Any]) -> str:
        token = self._generate_token(user_id)
        expiry = datetime.utcnow() + timedelta(seconds=self.ttl_seconds)
        self.sessions[token] = {
            "user_id": user_id,
            "attributes": attributes,
            "created_at": datetime.utcnow(),
            "expires_at": expiry,
            "last_activity": datetime.utcnow(),
        }
        logger.info("Session created for user=%s token=%s", user_id, token)
        return token

    def validate_session(self, session_token: str) -> Tuple[bool, Optional[str]]:
        session = self.sessions.get(session_token)
        if not session:
            return False, None

        if datetime.utcnow() > session["expires_at"]:
            del self.sessions[session_token]
            return False, None

        session["last_activity"] = datetime.utcnow()
        return True, session["user_id"]

    def destroy_session(self, session_token: str) -> bool:
        if session_token in self.sessions:
            del self.sessions[session_token]
            return True
        return False

    def _generate_token(self, user_id: str) -> str:
        payload = f"{user_id}:{time.time()}:{os.urandom(16).hex()}"
        signature = hmac.new(self.secret_key.encode("utf-8"), payload.encode("utf-8"), hashlib.sha256).hexdigest()
        return signature


class AuthenticationAdapter(ABC):
    def __init__(self, config: AdapterConfiguration):
        self.config = config
        self.cache: Dict[str, Tuple[Any, datetime]] = {}
        self.session_manager = SessionManager(config.secret_key or "default-secret-key", config.cache_ttl_seconds)
        self.status = AdapterStatus.ACTIVE

    @abstractmethod
    def authenticate(self, request: AuthenticationRequest) -> AuthenticationResponse:
        pass

    @abstractmethod
    def validate_credentials(self, username: str, credentials: Dict[str, Any]) -> bool:
        pass

    @abstractmethod
    def get_user_attributes(self, user_id: str) -> Dict[str, Any]:
        pass

    def _cache_get(self, key: str) -> Optional[Any]:
        if not self.config.enable_caching:
            return None

        cached = self.cache.get(key)
        if not cached:
            return None

        value, expiry = cached
        if datetime.utcnow() < expiry:
            return value

        del self.cache[key]
        return None

    def _cache_set(self, key: str, value: Any) -> None:
        if not self.config.enable_caching:
            return
        expiry = datetime.utcnow() + timedelta(seconds=self.config.cache_ttl_seconds)
        self.cache[key] = (value, expiry)

    def set_status(self, status: AdapterStatus):
        self.status = status

    def get_status(self) -> AdapterStatus:
        return self.status


class BasicAuthAdapter(AuthenticationAdapter):
    """Example username/password authentication adapter."""

    def authenticate(self, request: AuthenticationRequest) -> AuthenticationResponse:
        username = request.username
        credentials = request.credentials

        try:
            if not self.validate_credentials(username, credentials):
                raise AuthenticationFailedException("Invalid username or password")

            user_id = username
            attributes = self.get_user_attributes(user_id)
            session_token = self.session_manager.create_session(user_id, attributes)
            token_expiry = datetime.utcnow() + timedelta(seconds=self.config.cache_ttl_seconds)

            return AuthenticationResponse(
                success=True,
                user_id=user_id,
                session_token=session_token,
                token_expiry=token_expiry,
                attributes=attributes,
            )
        except Exception as exc:
            logger.exception("Basic authentication failed for username=%s", username)
            return AuthenticationResponse(
                success=False,
                user_id="",
                session_token="",
                token_expiry=datetime.utcnow(),
                attributes={},
                error_message=str(exc),
                error_code=getattr(exc, "error_code", "AUTH_ERROR"),
            )

    def validate_credentials(self, username: str, credentials: Dict[str, Any]) -> bool:
        password = credentials.get("password")
        if not username or not password:
            return False
        # Real implementation should validate against your IdP or LDAP directory.
        return True

    def get_user_attributes(self, user_id: str) -> Dict[str, Any]:
        key = f"user_attrs:{user_id}"
        cached = self._cache_get(key)
        if cached:
            return cached

        attrs = {
            "user_id": user_id,
            "email": f"{user_id}@example.com",
            "groups": ["users"],
            "authenticated_at": datetime.utcnow().isoformat(),
        }
        self._cache_set(key, attrs)
        return attrs


